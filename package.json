{
  "name": "@risserlabs/nestjs-keycloak",
  "version": "4.0.0",
  "description": "nestjs module for authenticating keycloak",
  "keywords": [
    "auth",
    "authentication",
    "authorization",
    "keycloak",
    "nestjs",
    "oidc"
  ],
  "homepage": "https://gitlab.com/bitspur/nestjs-keycloak",
  "bugs": {
    "url": "https://gitlab.com/bitspur/nestjs-keycloak/issues"
  },
  "license": "Apache-2.0",
  "author": "Clay Risser <email@clayrisser.com> (https://clayrisser.com)",
  "repository": "https://gitlab.com/bitspur/nestjs-keycloak",
  "files": [
    "lib",
    "src"
  ],
  "sideEffects": false,
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "publishConfig": {
    "@risserlabs:registry": "https://gitlab.com/api/v4/projects/52777030/packages/npm/",
    "registry": "https://gitlab.com/api/v4/projects/52777030/packages/npm/"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf lib coverage coverage-integration *.tsbuildinfo",
    "format": "oxfmt",
    "lint": "oxfmt --check && oxlint && tsc --noEmit",
    "test": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.mts"
  },
  "dependencies": {
    "@keycloak/keycloak-admin-client": "^26.7.1",
    "express-session": "^1.19.0",
    "keycloak-connect": "^26.1.1",
    "lodash": "^4.18.1",
    "qs": "^6.15.3"
  },
  "devDependencies": {
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^11.1.29",
    "@nestjs/core": "^11.1.29",
    "@nestjs/platform-express": "^11.1.29",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/testing": "^11.1.29",
    "@swc/core": "^1.15.47",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/lodash": "^4.17.25",
    "@types/node": "^26.2.0",
    "@types/qs": "^6.15.1",
    "@vitest/coverage-v8": "^4.1.10",
    "axios": "^1.19.0",
    "express": "^5.2.1",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typescript": "^5.9.3",
    "unplugin-swc": "^1.5.10",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "@nestjs/axios": "^4.0.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/graphql": "^13.0.0",
    "@nestjs/swagger": "^11.0.0",
    "axios": "^1.0.0",
    "express": "^4.18.2 || ^5.0.0",
    "rxjs": "^7.8.0"
  },
  "peerDependenciesMeta": {
    "@nestjs/graphql": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@10.32.1"
